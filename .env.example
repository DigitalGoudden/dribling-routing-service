# Variables de configuración del Microservicio de Ruteo

# Puerto de la API FastAPI
PORT=8088

# País para el mapa de OpenStreetMap (chile, colombia, etc.)
ROUTING_COUNTRY=chile

# URLs internas para Docker
VALHALLA_URL=http://valhalla:8002
VROOM_URL=http://vroom:3000

# Clave de autenticación para consumir la API desde Dribling
API_KEY=dribling_super_secret_token_2026

